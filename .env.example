# ==========================================
# 币安美股 bStocks 交易分析与盯盘机器人配置
# ==========================================

# 1. 币安远程 MCP 与 API 配置 (官方托管 Remote MCP 无需本地部署)
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_API_KEY=

# 2. 机器人通知 Webhook (任选或多选)
# 飞书自定义机器人 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx
# 企业微信机器人 Webhook 地址
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxx

# 3. 大模型 AI 配置 (支持 OpenAI / DeepSeek / Claude 等兼容接口)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. 数据存储路径 (本地默认 sqlite.db，Docker 映射为 /app/data/bstocks.db)
DB_PATH=data/bstocks.db
