# 八角 · 币安持仓监控与美股 2–4 周波段研究
# 仅为配置模板。更新项目时请勿覆盖已有 .env。

# 控制台访问：设置后使用 admin / 此密码登录。
# 公网使用 HTTPS 和访问限制；不设置密码时所有接口均可被访问者调用。
ADMIN_PASSWORD=

# 币安只读账户：持仓同步需要完整、配套的 HMAC Key / Secret。
# 不要授予交易或提现权限；Web 页面更换凭据时需验证当前 Secret。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# 底层美股数据：需要 FMP stable 日线、季度财务、新闻、财报日历权限。
# 订阅权限须自行确认，不保证免费套餐可用。
FMP_API_KEY=

# 兼容 OpenAI Chat Completions 的服务（Base URL 包含 /v1）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 研究/风险通知渠道，可选一个或同时配置两个。
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# 可选：飞书应用机器人长连接（不替代上述研究推送渠道）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 本地数据路径；Docker Compose 固定使用 /app/data/bstocks.db。
DB_PATH=data/bstocks.db

# 自动研究、时区、筛选阈值及汇报偏好在 Web 配置中心保存。
# 数据库中的非空配置优先于环境变量；密钥在 SQLite 中明文保存。
